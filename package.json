{
  "name": "copilot-operator",
  "version": "0.1.11",
  "private": false,
  "type": "module",
  "description": "Automates a Microsoft 365 Copilot chat: sends prompts, extracts commands, runs them, reports back.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:package": "node scripts/build-package.mjs",
    "prepack": "node scripts/build-package.mjs",
    "check:pacing": "tsx test/pacing.check.ts",
    "check:runner": "tsx test/runner.check.ts",
    "check:chat": "tsx test/chat.check.ts",
    "check:context": "tsx test/context.check.ts",
    "check:mirror": "tsx test/mirror.check.ts",
    "cop": "tsx src/cli.ts",
    "check:parser": "tsx test/parser.check.ts",
    "check:report": "tsx test/report.check.ts",
    "check": "npm run check:parser && npm run check:damage && npm run check:session && npm run check:report && npm run check:runner && npm run check:mirror && npm run check:vcs && npm run check:plan && npm run check:checks && npm run check:workdir && npm run check:processes && npm run check:environment && npm run check:clock && npm run check:crash && npm run check:clipboard && npm run check:restart && npm run check:review && npm run check:chat && npm run check:context && npm run check:pacing && npm run check:shells && npm run check:save && npm run check:guide && npm run check:bundle && npm run check:runname && npm run check:dangerous && npm run check:programs && npm run check:manifest && npm run check:lock && npm run check:isolation && npm run check:security && npm run check:update && npm run check:persona && npm run check:script && npm run check:batch && npm run check:confinement && npm run check:network && npm run check:hardening && npm run check:package && npm run check:models && npm run check:continue && npm run check:startfrom && npm run check:diff && npm run check:integrity && npm run check:scope && npm run check:progress && npm run check:metrics && npm run check:modelpicker && npm run check:formatrepair && npm run check:intent && npm run check:sync && npm run check:desktop && npm run check:e2e-run && npm run check:e2e-continue && npm run check:e2e-interrupt",
    "probe": "tsx scripts/probe-locators.ts",
    "check:damage": "tsx test/damage.check.ts",
    "api": "npm run build && node dist/src/api/main.js",
    "api:start": "node dist/src/api/main.js",
    "web": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web",
    "check:session": "tsx test/session.check.ts",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs --open",
    "check:vcs": "tsx test/vcs.check.ts",
    "check:plan": "tsx test/plan.check.ts",
    "check:checks": "tsx test/checks.check.ts",
    "check:workdir": "tsx test/workdir.check.ts",
    "check:processes": "tsx test/processes.check.ts",
    "check:environment": "tsx test/environment.check.ts",
    "check:clock": "tsx test/clock.check.ts",
    "check:crash": "tsx test/crash.check.ts",
    "check:clipboard": "tsx test/clipboard.check.ts",
    "check:restart": "tsx test/restart.check.ts",
    "check:review": "tsx test/review.check.ts",
    "check:shells": "tsx test/shells.check.ts",
    "check:save": "tsx test/save.check.ts",
    "check:guide": "tsx test/guide.check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && npm run typecheck --workspace web",
    "check:bundle": "tsx test/bundle.check.ts",
    "check:runname": "tsx test/runname.check.ts",
    "update": "node scripts/update.mjs",
    "check:dangerous": "tsx test/dangerous.check.ts",
    "check:programs": "tsx test/programs.check.ts",
    "check:manifest": "tsx test/manifest.check.ts",
    "check:lock": "tsx test/lock.check.ts",
    "check:isolation": "tsx test/isolation.check.ts",
    "check:security": "tsx test/security.check.ts",
    "check:update": "tsx test/update.check.ts",
    "check:persona": "tsx test/persona.check.ts",
    "check:script": "tsx test/script.check.ts",
    "check:batch": "tsx test/batch.check.ts",
    "check:confinement": "tsx test/confinement.check.ts",
    "check:network": "tsx test/network.check.ts",
    "check:hardening": "tsx test/hardening.check.ts",
    "check:package": "tsx test/package.check.ts",
    "check:models": "tsx test/models.check.ts",
    "check:continue": "tsx test/continue.check.ts",
    "check:startfrom": "tsx test/startfrom.check.ts",
    "check:diff": "tsx test/diff.check.ts",
    "check:integrity": "tsx test/integrity.check.ts",
    "check:scope": "tsx test/scope.check.ts",
    "check:progress": "tsx test/progress.check.ts",
    "check:metrics": "tsx test/metrics.check.ts",
    "check:modelpicker": "tsx test/modelpicker.check.ts",
    "check:formatrepair": "tsx test/formatrepair.check.ts",
    "check:intent": "tsx test/intent.check.ts",
    "check:sync": "tsx test/sync.check.ts",
    "check:desktop": "tsx test/desktop.check.ts",
    "check:e2e-run": "tsx test/e2e-run.check.ts",
    "check:e2e-continue": "tsx test/e2e-continue.check.ts",
    "check:e2e-interrupt": "tsx test/e2e-interrupt.check.ts",
    "check:ui": "node scripts/build-package.mjs && tsx test/ui.check.ts",
    "check:all": "npm run check && npm run check:ui"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "commander": "^15.0.0",
    "ignore": "^7.0.9",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-markov-666/copilot-operator.git"
  },
  "bin": {
    "cop": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/web",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "keywords": [
    "copilot",
    "microsoft-365",
    "automation",
    "playwright",
    "agent"
  ],
  "workspaces": [
    "web"
  ]
}
