{
  "name": "copilot-operator",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Automates a Microsoft 365 Copilot chat: sends prompts, extracts commands, runs them, reports back.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "login": "tsx scripts/login.ts",
    "check:pacing": "tsx test/pacing.check.ts",
    "check:runner": "tsx test/runner.check.ts",
    "check:chat": "tsx test/chat.check.ts",
    "check:context": "tsx test/context.check.ts",
    "check:mirror": "tsx test/mirror.check.ts",
    "cop": "tsx src/cli.ts",
    "check:parser": "tsx test/parser.check.ts",
    "check:report": "tsx test/report.check.ts",
    "check": "npm run check:parser && npm run check:damage && npm run check:session && npm run check:report && npm run check:runner && npm run check:mirror && npm run check:vcs && npm run check:plan && npm run check:checks && npm run check:workdir && npm run check:processes && npm run check:environment && npm run check:clock && npm run check:crash && npm run check:clipboard && npm run check:restart && npm run check:review && npm run check:chat && npm run check:context && npm run check:pacing && npm run check:shells && npm run check:save && npm run check:guide && npm run check:bundle && npm run check:runname",
    "probe": "tsx scripts/probe-locators.ts",
    "check:damage": "tsx test/damage.check.ts",
    "api": "npm run build && node dist/src/api/main.js",
    "api:start": "node dist/src/api/main.js",
    "web": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web",
    "check:session": "tsx test/session.check.ts",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs --open",
    "check:vcs": "tsx test/vcs.check.ts",
    "check:plan": "tsx test/plan.check.ts",
    "check:checks": "tsx test/checks.check.ts",
    "check:workdir": "tsx test/workdir.check.ts",
    "check:processes": "tsx test/processes.check.ts",
    "check:environment": "tsx test/environment.check.ts",
    "check:clock": "tsx test/clock.check.ts",
    "check:crash": "tsx test/crash.check.ts",
    "check:clipboard": "tsx test/clipboard.check.ts",
    "check:restart": "tsx test/restart.check.ts",
    "check:review": "tsx test/review.check.ts",
    "check:shells": "tsx test/shells.check.ts",
    "check:save": "tsx test/save.check.ts",
    "check:guide": "tsx test/guide.check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace web",
    "check:bundle": "tsx test/bundle.check.ts",
    "check:runname": "tsx test/runname.check.ts",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "commander": "^15.0.0",
    "ignore": "^7.0.9",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-markov-666/copilot-operator.git"
  },
  "bin": {
    "cop": "dist/src/cli.js"
  },
  "main": "dist/src/cli.js",
  "files": [
    "dist",
    "prompts",
    "run.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "web"
  ]
}
